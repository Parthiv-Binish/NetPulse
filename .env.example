# Web client — safe to expose only these public values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values — never add these to NEXT_PUBLIC_ variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_TOKEN=

# Worker tuning
CHECK_INTERVAL_SECONDS=60
PING_ATTEMPTS=3
PING_TIMEOUT_SECONDS=2
PORT=10000

# Local private-network agent
NETPULSE_API_URL=http://127.0.0.1:10000
NETPULSE_AGENT_ID=
NETPULSE_AGENT_TOKEN=
NETPULSE_LOCATION_ID=
NETPULSE_POLL_SECONDS=30
